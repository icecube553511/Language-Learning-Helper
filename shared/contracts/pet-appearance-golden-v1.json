{
  "contractVersion": "pet-appearance-v1",
  "sourceDirectory": "shared/assets/branding/pet_states",
  "runtimeDirectory": "shared/assets/pets/states",
  "requiredStateAssets": ["pain.png", "scared.png", "sleep.png", "hungry.png"],
  "happyAssetPattern": "^happy([1-9][0-9]*)\\.png$",
  "assetSet": {
    "stateAssets": {
      "pain": "pain.png",
      "scared": "scared.png",
      "sleep": "sleep.png",
      "hungry": "hungry.png"
    },
    "happyAssets": ["happy1.png", "happy2.png"]
  },
  "thresholds": {
    "largeLandingSpeed": 437.5,
    "airborneSeconds": 3.0,
    "stationarySeconds": 30.0,
    "doubleTapWindowMs": 300,
    "hungrySatiety": 0.0
  },
  "priority": ["pain", "scared", "hungry", "sleep", "happy", "normal"],
  "priorityDecision": "recommended-pain-before-scared",
  "priorityConfirmed": false,
  "priorityOpenQuestion": "User specified rules 1 and 2 above rule 5 but did not order 1 versus 2; confirm pain before scared before enabling.",
  "missingAssetPolicy": "skip-missing-choice-and-fallback-to-normal",
  "featureEnabledWhen": "all-required-state-assets-and-at-least-one-happy-asset-exist-and-priority-is-confirmed",
  "currentAvailability": {
    "enabled": false,
    "stateAssets": {"pain": null, "scared": null, "sleep": null, "hungry": null},
    "happyAssets": [],
    "disabledReason": "appearance PNG set is incomplete"
  },
  "vectors": [
    {
      "name": "large-landing-boundary",
      "context": {"landingImpactSpeed": 437.5},
      "expected": {"appearance": "pain", "asset": "pain.png", "reason": "large-landing"}
    },
    {
      "name": "airborne-three-second-boundary",
      "context": {"airborneSeconds": 3.0},
      "expected": {"appearance": "scared", "asset": "scared.png", "reason": "airborne-too-long"}
    },
    {
      "name": "strict-zero-satiety",
      "context": {"satiety": 0.0},
      "expected": {"appearance": "hungry", "asset": "hungry.png", "reason": "satiety-zero"}
    },
    {
      "name": "near-zero-is-not-zero",
      "context": {"satiety": 0.001},
      "expected": {"appearance": "normal", "asset": null, "reason": "normal"}
    },
    {
      "name": "stationary-thirty-second-boundary",
      "context": {"stationarySeconds": 30.0, "moving": false},
      "expected": {"appearance": "sleep", "asset": "sleep.png", "reason": "stationary-too-long"}
    },
    {
      "name": "happy-group-is-indexed",
      "context": {"rapidDoubleTap": true, "happyAssetIndex": 1, "moving": false},
      "expected": {"appearance": "happy", "asset": "happy2.png", "reason": "stationary-double-tap"}
    },
    {
      "name": "priority-pain-over-all",
      "context": {"landingImpactSpeed": 437.5, "airborneSeconds": 3.0, "satiety": 0.0, "stationarySeconds": 30.0, "rapidDoubleTap": true, "moving": false},
      "expected": {"appearance": "pain", "asset": "pain.png", "reason": "large-landing"}
    },
    {
      "name": "priority-scared-over-lower-choices",
      "context": {"airborneSeconds": 3.0, "satiety": 0.0, "stationarySeconds": 30.0, "rapidDoubleTap": true, "moving": false},
      "expected": {"appearance": "scared", "asset": "scared.png", "reason": "airborne-too-long"}
    },
    {
      "name": "empty-asset-set-disables-feature",
      "assetSet": "empty",
      "context": {"landingImpactSpeed": 437.5, "airborneSeconds": 3.0, "satiety": 0.0, "stationarySeconds": 30.0, "rapidDoubleTap": true, "moving": false},
      "expected": {"appearance": "normal", "asset": null, "reason": "normal"}
    }
  ]
}
